import hudson.model.*
import jenkins.model.*

def nodeName = "jnlp-agent"

StringBuilder yamlOutput = new StringBuilder()

Jenkins.instance.nodes.each { node ->
    if (node.getNodeName() == nodeName) {
        yamlOutput.append("- name: ").append(node.getNodeName()).append("\n")
        yamlOutput.append("  secret: ").append(node.getComputer().getJnlpMac()).append("\n")
        return
    }
}

println(yamlOutput.toString())
