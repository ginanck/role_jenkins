import jenkins.model.Jenkins
import hudson.security.AuthorizationStrategy

// Define the username and role mapping
def userRoles = [
  "user1": ["role1", "role2"],
  "user2": ["role2"],
  "user3": ["role3"]
]

// Get the Jenkins instance
def jenkins = Jenkins.getInstance()

// Get the authorization strategy
def authStrategy = jenkins.getAuthorizationStrategy()

// Iterate over the user roles map and assign roles to users
userRoles.each { username, roles ->
    // Get the user ID for the username
    def userId = jenkins.getUserId(username)

    // Set the roles for the user
    authStrategy.addRoles(userId, roles as String[])
}

// Save the Jenkins configuration
jenkins.save()
