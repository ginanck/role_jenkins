import hudson.model.*
import jenkins.model.*
import org.yaml.snakeyaml.Yaml

List<Map> agentDataList = []

Jenkins.instance.nodes.each { node ->
    Map agentData = [:]
    agentData['name'] = node.getNodeName()
    agentData['secret'] = node.getComputer().getJnlpMac()
    agentDataList.add(agentData)
}

Yaml yaml = new Yaml()
println(yaml.dump(agentDataList))