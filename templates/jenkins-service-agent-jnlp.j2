[Unit]
Description=Jenkins JNLP Agent
After=network.target

[Service]
User={{ jenkins_user }}
Group={{ jenkins_group }}
WorkingDirectory={{ jenkins_dir }}
ExecStart=/usr/bin/java -jar {{ jenkins_dir }}/agent.jar -jnlpUrl {{ jenkins_http_url }}/computer/{{ AgentName }}/slave-agent.jnlp -secret {{ AgentSecret }} -workDir "{{ item.workDirSettings.workDirPath }}"
Restart=always

[Install]
WantedBy=multi-user.target