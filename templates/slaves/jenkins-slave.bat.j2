@echo off
setlocal enabledelayedexpansion

set AGENT_DIR={{ jenkins_win_dir }}
set AGENT_JAR=%AGENT_DIR%\agent.jar
set JENKINS_URL={{ jenkins_http_url }}
set SERVICE_NAME=JenkinsAgent-{{ AgentName }}

:: Create directories if they don't exist
if not exist "%AGENT_DIR%" mkdir "%AGENT_DIR%"

:: Download agent.jar if it doesn't exist
if not exist "%AGENT_JAR%" (
    echo Downloading Jenkins agent.jar...
    powershell -Command "(New-Object System.Net.WebClient).DownloadFile('%JENKINS_URL%/jnlpJars/agent.jar', '%AGENT_JAR%')"
    if !errorlevel! neq 0 (
        echo Failed to download agent.jar
        exit /b !errorlevel!
    )
)

:: Copy the slave batch file
copy "jenkins-slave.bat" "%AGENT_DIR%\jenkins-slave.bat"

:: Install as a Windows service using NSSM (if not already installed)
sc query %SERVICE_NAME% > nul
if !errorlevel! neq 0 (
    echo Installing Jenkins agent as a service...
    nssm install %SERVICE_NAME% "%AGENT_DIR%\jenkins-slave.bat"
    nssm set %SERVICE_NAME% DisplayName "Jenkins Agent - {{ AgentName }}"
    nssm set %SERVICE_NAME% Description "Jenkins JNLP Agent for {{ AgentName }}"
    nssm set %SERVICE_NAME% Start SERVICE_AUTO_START
    nssm set %SERVICE_NAME% AppStdout "%AGENT_DIR%\logs\stdout.log"
    nssm set %SERVICE_NAME% AppStderr "%AGENT_DIR%\logs\stderr.log"
    nssm set %SERVICE_NAME% AppRotateFiles 1
)

:: Start the service
net start %SERVICE_NAME%
echo Jenkins agent service installed and started.
