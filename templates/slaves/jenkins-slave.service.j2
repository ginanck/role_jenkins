# {{ ansible_managed }}

[Unit]
Description=Jenkins JNLP Slave
After=network.target

[Service]
Type=simple
User={{ jenkins_user }}
Group={{ jenkins_group }}

Environment="JENKINS_HOME={{ jenkins_dir }}"
{% for key, value in jenkins_agent_env_vars.items() %}
Environment="{{ key }}={{ value }}"
{% endfor %}

WorkingDirectory={{ jenkins_dir }}

# Download agent.jar if it doesn't exist
ExecStartPre=/bin/sh -c 'if [ ! -f {{ jenkins_dir }}/agent.jar ]; then curl -s -o {{ jenkins_dir }}/agent.jar {{ jenkins_http_url }}/jnlpJars/agent.jar; fi'

# Start the Jenkins agent
ExecStart=/usr/bin/java {{ jenkins_agent_java_opts }} \
  -jar {{ jenkins_dir }}/agent.jar \
  -jnlpUrl {{ jenkins_http_url }}/computer/{{ AgentName }}/slave-agent.jnlp \
  -secret {{ AgentSecret }} \
  -workDir "{{ workDirPath }}" \
  -failIfWorkDirIsMissing \
  -noreconnect

Restart=always
RestartSec=10
StartLimitInterval=0

[Install]
WantedBy=multi-user.target
