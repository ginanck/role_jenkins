#jinja2: lstrip_blocks: "True"

jenkins:
  authorizationStrategy:
    roleBased:
      roles:
        global:
        {% for role in jenkins_config_authorization_roles %}
        - assignments:
          {% for assignment in role.assignments %}
          - "{{ assignment }}"
          {% endfor %}
          name: "{{ role.name }}"
          pattern: "{{ role.pattern }}"
          permissions:
          {% for permission in role.permissions %}
          - "{{ permission }}"
          {% endfor %}
        {% endfor %}
