credentials:
  system:
    domainCredentials:
    - credentials:
      - basicSSHUserPrivateKey:
          description: "Jenkins SSH key for Agent"
          id: "JENKINS_AGENT_SSH_KEY"
          privateKeySource:
            directEntry:
              privateKey: |
{{ jenkins_agent_ssh_private_key | indent(width=16, first=True) }}
          scope: GLOBAL
          username: "{{ jenkins_user }}"
